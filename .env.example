NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional, server-side public Payload REST API base, including /api.
# Leave empty for bundled local demo content. When set, CMS is authoritative for
# settings, solutions, partners, projects and insights.
# Media uses this origin too: it must be reachable by the browser.
# Local CMS-backed testing: http://localhost:3101/api
CMS_API_URL=

# Shared with the separate CMS. Keep these server-side and use different values.
CMS_ADMIN_URL=http://localhost:3101/admin
CMS_PREVIEW_SECRET=
CMS_REVALIDATE_SECRET=

# Reserved for the separate Core API integration; root form submission is disabled.
CORE_API_URL=http://localhost:8080
