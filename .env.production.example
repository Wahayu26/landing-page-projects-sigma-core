APP_VERSION=replace-with-git-commit
HTTP_PORT=80
NEXT_PUBLIC_SERVER_URL=https://sigmacore.id

# Separate Payload CMS. The public app only reads its HTTP API.
CMS_API_URL=https://cms.sigmacore.id/api
CMS_ADMIN_URL=https://cms.sigmacore.id/admin
CMS_PREVIEW_SECRET=replace-with-random-secret-shared-with-cms
CMS_REVALIDATE_SECRET=replace-with-a-different-random-secret-shared-with-cms
SCS_EDGE_NETWORK=scs-edge

# Core API (server-side only, used by /api/inquiries)
CORE_API_URL=http://localhost:8080

