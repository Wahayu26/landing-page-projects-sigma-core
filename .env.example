NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional, server-side public Payload REST API base, including /api.
# Leave empty for bundled demo solutions. When set, CMS is authoritative:
# empty/unpublished stays empty, API failures surface rather than revive demo data.
# Media uses this origin too: it must be reachable by the browser.
# Local CMS-backed testing: http://localhost:3101/api
CMS_API_URL=

# Reserved for the separate Core API integration; root form submission is disabled.
CORE_API_URL=http://localhost:8080
